# LEXAR Environment Configuration
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── Gemini (recommended — much better answers) ────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
# When set, Gemini is used for generation instead of flan-t5-base
GEMINI_API_KEY=

# Gemini model to use (gemini-2.0-flash is fast + free-tier friendly)
GEMINI_MODEL=gemini-2.0-flash

# ── Model (fallback if GEMINI_API_KEY is not set) ─────────────────────────
# HuggingFace model for answer generation (default: google/flan-t5-base)
GENERATOR_MODEL=google/flan-t5-base

# Evidence sufficiency threshold (0.0–1.0, default: 0.5)
EVIDENCE_THRESHOLD=0.5

# ── Retrieval ─────────────────────────────────────────────────────────────
# Default index: ipc | ipc_crpc | ipc_crpc_iea | lexar_medium
DEFAULT_INDEX=ipc
RETRIEVAL_TOP_K=10
RERANKING_TOP_K=3

# ── Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
UPLOAD_DIR=data/raw_docs
PROCESSED_DIR=data/processed_docs
